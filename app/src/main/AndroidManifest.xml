<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home Screen Clock Widget -->
        <receiver
            android:name=".receiver.CassetteClockWidgetProvider"
            android:label="Minimalist Clock (4x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <!-- Home Screen Music Player Widget -->
        <receiver
            android:name=".receiver.CassettePlayerWidgetProvider"
            android:label="Spotify Music Player (4x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.ACTION_WIDGET_PLAY_PAUSE" />
                <action android:name="com.example.ACTION_WIDGET_NEXT" />
                <action android:name="com.example.ACTION_WIDGET_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_info" />
        </receiver>

        <!-- Home Screen Quote Widget -->
        <receiver
            android:name=".receiver.CassetteQuoteWidgetProvider"
            android:label="Mood Quotes (4x1)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.ACTION_WIDGET_SHUFFLE_QUOTE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quote_info" />
        </receiver>

        <!-- Home Screen 3D Analog Chrono Clock Widget -->
        <receiver
            android:name=".receiver.CassetteAnalog3DWidgetProvider"
            android:label="3D Chrono Dial (2x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_analog_3d_info" />
        </receiver>

        <!-- Home Screen 3D Cassette Tape Clock Widget -->
        <receiver
            android:name=".receiver.Cassette3DWidgetProvider"
            android:label="3D Cassette Tape (4x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cassette_3d_info" />
        </receiver>

        <!-- Home Screen Countdown Drop Radar Widget -->
        <receiver
            android:name=".receiver.CassetteCountdownWidgetProvider"
            android:label="Drop Countdown (4x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.ACTION_WIDGET_CYCLE_COUNTDOWN" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>

        <!-- Home Screen Night Horizon & Lunar Phase Widget -->
        <receiver
            android:name=".receiver.CassetteHorizonWidgetProvider"
            android:label="Night Horizon (4x2)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_horizon_info" />
        </receiver>

        <!-- Spotify Broadcast Receiver for zero-permission real-time song detection -->
        <receiver
            android:name=".receiver.SpotifyBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.spotify.music.metadatachanged" />
                <action android:name="com.spotify.music.playbackstatechanged" />
                <action android:name="com.spotify.music.queuechanged" />
            </intent-filter>
        </receiver>

        <!-- Media Notification Listener Service for full Spotify / Phone Media Sync & Controls -->
        <service
            android:name=".service.CassetteMediaListenerService"
            android:exported="true"
            android:label="Cassette Media Sync"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
